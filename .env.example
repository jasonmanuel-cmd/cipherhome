# ============================================================
# CIPHER SOVEREIGN v2.0 — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Local Ollama URL
OLLAMA_URL=http://localhost:11434

# Anthropic Claude API key (cloud fallback — optional)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase project credentials
# Get from: https://supabase.com/dashboard → project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Cipher server port
PORT=3131

# Optional: lock down endpoints with an API key
# Leave blank for open local-only mode
CIPHER_API_KEY=

# Embedding model for semantic memory (must be pulled in Ollama first)
# Run: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# Rate limit on /chat and /tool (requests per minute per IP)
RATE_LIMIT_RPM=30
